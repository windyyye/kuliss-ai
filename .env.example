# Default Database (SQLite - Easiest for local setup)
DB_TYPE=sqlite
DB_URL=messages.db

# If you want to use PostgreSQL for Docker / Production, comment out the above and uncomment the following:
# DB_TYPE=postgres
# DB_URL=postgres://postgres:CHANGE_THIS_TO_SECURE_PASSWORD@localhost:5432/kuliss_db?sslmode=disable
# DB_USER=postgres
# DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
# DB_NAME=kuliss_db

# AI Provider: "ollama" (local) or "openrouter" (cloud)
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# For OpenRouter (uncomment and fill):
# AI_PROVIDER=openrouter
# AI_API_URL=https://openrouter.ai/api/v1
# AI_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# AI_API_KEY=sk-or-v1-your-key-here